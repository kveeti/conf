{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["homelab", "logs"],
  "title": "Homelab Logs",
  "uid": "homelab-logs",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
        "query": { "refId": "host", "type": "fieldValue", "field": "host" },
        "definition": "fieldValue(host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
        "query": { "refId": "service", "type": "fieldValue", "field": "service" },
        "definition": "fieldValue(service)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "critical,error,warning,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "search",
        "label": "LogsQL filter",
        "type": "textbox",
        "query": "*",
        "current": { "text": "*", "value": "*" },
        "options": [{ "text": "*", "value": "*", "selected": true }]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 0 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "expr": "host:~\"${host:pipe}\" service:~\"${service:pipe}\" level:~\"${level:pipe}\" ${search:raw}",
          "queryType": "hits"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warnings and errors",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0 },
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "expr": "host:~\"${host:pipe}\" service:~\"${service:pipe}\" level:~\"warning|error|critical\" ${search:raw}",
          "queryType": "hits"
        }
      ]
    },
    {
      "id": 3,
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 7 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "expr": "host:~\"${host:pipe}\" service:~\"${service:pipe}\" level:~\"${level:pipe}\" ${search:raw}",
          "queryType": "instant",
          "maxLines": 1000
        }
      ]
    }
  ]
}
