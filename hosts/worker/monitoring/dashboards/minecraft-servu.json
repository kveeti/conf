{
  "uid": "minecraft-servu",
  "title": "Minecraft · servu",
  "description": "Player sessions, saved game stats, Java resources, world storage and local Restic backups. Connected time includes AFK; game time uses saved ticks at nominal 20 TPS. Missing data is unknown.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["minecraft", "homelab"],
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {"id":1,"title":"Server · uptime","type":"stat","description":"Green means Java is running; the value is its process uptime. Red means stopped. Missing process/status data is Unknown, not stopped.","gridPos":{"x":0,"y":0,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"(minecraft_process_uptime_seconds{server=\"servu\",instance=\"minecraft\"} and on(server,instance) (minecraft_server_running{server=\"servu\",instance=\"minecraft\"} == 1)) or on(server,instance) ((minecraft_server_running{server=\"servu\",instance=\"minecraft\"} == 0) - 1)","instant":true}],"fieldConfig":{"defaults":{"unit":"s","mappings":[{"type":"value","options":{"-1":{"text":"Stopped","color":"red"}}},{"type":"special","options":{"match":"null","result":{"text":"Unknown","color":"#4b5563"}}}],"noValue":"Unknown","thresholds":{"mode":"absolute","steps":[{"value":null,"color":"red"},{"value":0,"color":"green"}]}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","textMode":"value"}},
    {"id":2,"title":"Players online","type":"stat","gridPos":{"x":4,"y":0,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_players_online{server=\"servu\",instance=\"minecraft\"}","instant":true}],"fieldConfig":{"defaults":{"unit":"short","noValue":"Unknown"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":3,"title":"Java resident RAM","type":"stat","gridPos":{"x":8,"y":0,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"sum(minecraft_process_resident_memory_bytes{server=\"servu\",instance=\"minecraft\"})","instant":true}],"fieldConfig":{"defaults":{"unit":"bytes","noValue":"Unknown / stopped"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":4,"title":"Backups","type":"stat","description":"State prioritizes an attempt in progress, otherwise reports the last attempt's outcome. Last success is the age of the last fully completed pass (snapshot, saving restored, retention/pruning). Snapshot count is refreshed every five minutes. Last duration includes cleanup. These are local backups, not off-host copies.","gridPos":{"x":12,"y":0,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"max((2 * (minecraft_backup_in_progress{server=\"servu\",instance=\"minecraft\"} == 1)) or on(server,instance) (minecraft_backup_attempt_success{server=\"servu\",instance=\"minecraft\"} and on(server,instance) (minecraft_backup_in_progress{server=\"servu\",instance=\"minecraft\"} == 0))) or vector(-1)","legendFormat":"State","instant":true},{"refId":"B","expr":"max(time() - minecraft_backup_last_success_timestamp_seconds{server=\"servu\",instance=\"minecraft\"}) or vector(-1)","legendFormat":"Last success","instant":true},{"refId":"C","expr":"max(minecraft_backup_snapshots{server=\"servu\",instance=\"minecraft\"}) or vector(-1)","legendFormat":"Snapshots","instant":true},{"refId":"D","expr":"max(minecraft_backup_duration_seconds{server=\"servu\",instance=\"minecraft\"}) or vector(-1)","legendFormat":"Last duration","instant":true}],"fieldConfig":{"defaults":{"unit":"short","decimals":0,"noValue":"Unknown","color":{"mode":"fixed","fixedColor":"#d1d5db"},"mappings":[{"type":"value","options":{"-1":{"text":"Unknown","color":"#9ca3af"}}}]},"overrides":[{"matcher":{"id":"byFrameRefID","options":"A"},"properties":[{"id":"unit","value":"none"},{"id":"mappings","value":[{"type":"value","options":{"-1":{"text":"Unknown","color":"#9ca3af"},"0":{"text":"Failed","color":"#F2495C"},"1":{"text":"OK","color":"#73BF69"},"2":{"text":"Running","color":"#5794F2"}}}]}]},{"matcher":{"id":"byFrameRefID","options":"B"},"properties":[{"id":"unit","value":"s"},{"id":"color","value":{"mode":"thresholds"}},{"id":"thresholds","value":{"mode":"absolute","steps":[{"value":null,"color":"#73BF69"},{"value":1800,"color":"#FF9830"},{"value":3600,"color":"#F2495C"}]}}]},{"matcher":{"id":"byFrameRefID","options":"D"},"properties":[{"id":"unit","value":"s"}]}]},"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"orientation":"horizontal","textMode":"value_and_name","colorMode":"value","graphMode":"none"}},
    {"id":5,"title":"Disk · /home","type":"stat","description":"Free space excludes ext4's root-reserved blocks. Used percentage matches df: used / (used + available). The exporter measures the real server filesystem directly.","gridPos":{"x":0,"y":4,"w":12,"h":3},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_filesystem_avail_bytes{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Free","instant":true},{"refId":"B","expr":"100 * (minecraft_filesystem_size_bytes{server=\"servu\",instance=\"minecraft\"} - minecraft_filesystem_free_bytes{server=\"servu\",instance=\"minecraft\"}) / (minecraft_filesystem_size_bytes{server=\"servu\",instance=\"minecraft\"} - minecraft_filesystem_free_bytes{server=\"servu\",instance=\"minecraft\"} + minecraft_filesystem_avail_bytes{server=\"servu\",instance=\"minecraft\"})","legendFormat":"Used","instant":true}],"fieldConfig":{"defaults":{"unit":"bytes","noValue":"Unknown","color":{"mode":"fixed","fixedColor":"#d1d5db"}},"overrides":[{"matcher":{"id":"byFrameRefID","options":"B"},"properties":[{"id":"unit","value":"percent"},{"id":"decimals","value":0},{"id":"color","value":{"mode":"thresholds"}},{"id":"thresholds","value":{"mode":"absolute","steps":[{"value":null,"color":"#73BF69"},{"value":70,"color":"#FF9830"},{"value":85,"color":"#F2495C"}]}}]}]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"orientation":"horizontal","textMode":"value_and_name","colorMode":"value","graphMode":"none"}},
    {"id":7,"title":"Player activity · green = online","type":"state-timeline","description":"Connected time includes AFK. Offline segments are transparent; gaps mean unknown. Graph follows your browser timezone; the server logs use UTC.","maxDataPoints":10000,"gridPos":{"x":0,"y":7,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_player_online{server=\"servu\",instance=\"minecraft\"}","legendFormat":"{{player}}"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"Offline","color":"#00000000"},"1":{"text":"Online","color":"#73BF69"}}}],"custom":{"fillOpacity":100,"lineWidth":0,"spanNulls":false,"hideFrom":{"legend":false,"tooltip":false,"viz":false}},"color":{"mode":"fixed","fixedColor":"#4b5563"}},"overrides":[]},"options":{"mergeValues":true,"showValue":"never","alignValue":"left","rowHeight":0.7,"legend":{"showLegend":false},"tooltip":{"mode":"multi","sort":"none"}}},
    {
      "id":9,"title":"Player overview","type":"table",
      "description":"State and saved counters are evaluated at the selected range's end. Connected (range) is approximate wall-clock connected time in that range, including AFK. Game total is saved play_time / 20 ticks, not exact wall time under lag. Deaths, kills and mined blocks are saved totals, NOT changes in the selected range. Saved counters before monitoring began are unavailable, shown as —, not zero.",
      "gridPos":{"x":0,"y":15,"w":24,"h":6},"datasource":{"type":"prometheus","uid":"victoriametrics"},
      "targets":[
        {"refId":"A","expr":"max by(player) (minecraft_player_online{server=\"servu\",instance=\"minecraft\"})","format":"table","instant":true,"range":false},
        {"refId":"B","expr":"sum by(player) (sum_over_time(minecraft_player_online{server=\"servu\",instance=\"minecraft\"}[$__range:30s]) * 30)","format":"table","instant":true,"range":false},
        {"refId":"C","expr":"max by(player) (minecraft_player_game_play_seconds_total{server=\"servu\",instance=\"minecraft\"}) or on(player) (-1 * group by(player) (minecraft_player_online{server=\"servu\",instance=\"minecraft\"}))","format":"table","instant":true,"range":false},
        {"refId":"D","expr":"max by(player) (minecraft_player_deaths_total{server=\"servu\",instance=\"minecraft\"}) or on(player) (-1 * group by(player) (minecraft_player_online{server=\"servu\",instance=\"minecraft\"}))","format":"table","instant":true,"range":false},
        {"refId":"E","expr":"max by(player) (minecraft_player_mob_kills_total{server=\"servu\",instance=\"minecraft\"}) or on(player) (-1 * group by(player) (minecraft_player_online{server=\"servu\",instance=\"minecraft\"}))","format":"table","instant":true,"range":false},
        {"refId":"F","expr":"max by(player) (minecraft_player_blocks_mined_total{server=\"servu\",instance=\"minecraft\"}) or on(player) (-1 * group by(player) (minecraft_player_online{server=\"servu\",instance=\"minecraft\"}))","format":"table","instant":true,"range":false}
      ],
      "transformations":[
        {"id":"joinByField","options":{"byField":"player","mode":"outerTabular"}},
        {"id":"filterFieldsByName","options":{"include":{"pattern":"^(player|Value #[A-F])$"}}},
        {"id":"organize","options":{"indexByName":{"player":0,"Value #A":1,"Value #B":2,"Value #C":3,"Value #D":4,"Value #E":5,"Value #F":6},"renameByName":{"player":"Player","Value #A":"State (at end)","Value #B":"Connected (range)","Value #C":"Game total (saved)","Value #D":"Deaths (total)","Value #E":"Mob kills (total)","Value #F":"Blocks mined (total)"}}}
      ],
      "fieldConfig":{"defaults":{"unit":"short","decimals":0,"noValue":"—","mappings":[{"type":"value","options":{"-1":{"text":"—","color":"#9ca3af"}}}],"custom":{"align":"right","cellOptions":{"type":"auto"}}},"overrides":[
        {"matcher":{"id":"byName","options":"Player"},"properties":[{"id":"unit","value":"string"},{"id":"custom.align","value":"left"},{"id":"custom.width","value":150}]},
        {"matcher":{"id":"byName","options":"State (at end)"},"properties":[{"id":"unit","value":"none"},{"id":"custom.align","value":"left"},{"id":"custom.width","value":130},{"id":"custom.cellOptions","value":{"type":"color-text"}},{"id":"mappings","value":[{"type":"value","options":{"0":{"text":"Offline","color":"#9ca3af"},"1":{"text":"Online","color":"#73BF69"}}},{"type":"special","options":{"match":"null","result":{"text":"Unknown","color":"#FF9830"}}}]}]},
        {"matcher":{"id":"byName","options":"Connected (range)"},"properties":[{"id":"unit","value":"s"}]},
        {"matcher":{"id":"byName","options":"Game total (saved)"},"properties":[{"id":"unit","value":"s"}]}
      ]},
      "options":{"showHeader":true,"showTypeIcons":false,"cellHeight":"sm","frameIndex":0,"sortBy":[{"displayName":"Connected (range)","desc":true}]}
    },
    {"id":8,"title":"Online players","type":"timeseries","gridPos":{"x":0,"y":21,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_players_online{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Online"}],"fieldConfig":{"defaults":{"min":0,"unit":"short","custom":{"lineInterpolation":"stepAfter","fillOpacity":15,"gradientMode":"none","spanNulls":false}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull","max"]}}},
    {"id":15,"title":"Backup pass duration","type":"timeseries","description":"Last attempt duration includes saving, snapshot creation, retention and pruning; status is refreshed every ten seconds.","gridPos":{"x":12,"y":21,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_backup_duration_seconds{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Last attempt"}],"fieldConfig":{"defaults":{"unit":"s","min":0,"custom":{"gradientMode":"none"}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull"]}}},
    {"id":10,"title":"CPU · Java and VM (cores used)","type":"timeseries","description":"1.0 means one fully utilized CPU core. VM has eight vCPUs.","gridPos":{"x":0,"y":27,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"sum(rate(minecraft_process_cpu_seconds_total{server=\"servu\",instance=\"minecraft\"}[$__rate_interval]))","legendFormat":"servu Java"},{"refId":"B","expr":"sum(1 - rate(node_cpu_seconds_total{instance=\"minecraft\",mode=\"idle\"}[$__rate_interval]))","legendFormat":"Whole VM"}],"fieldConfig":{"defaults":{"unit":"short","min":0,"custom":{"gradientMode":"none"}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull","max"]}}},
    {"id":11,"title":"Memory · Java and VM","type":"timeseries","description":"Java is resident process memory, not JVM heap. VM used memory is total minus available.","gridPos":{"x":12,"y":27,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"sum(minecraft_process_resident_memory_bytes{server=\"servu\",instance=\"minecraft\"})","legendFormat":"servu Java RSS"},{"refId":"B","expr":"node_memory_MemTotal_bytes{instance=\"minecraft\"} - node_memory_MemAvailable_bytes{instance=\"minecraft\"}","legendFormat":"Whole VM used"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0,"custom":{"gradientMode":"none"}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull","max"]}}},
    {"id":12,"title":"World dimension storage","type":"timeseries","description":"Allocated disk space, measured every five minutes.","gridPos":{"x":0,"y":34,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_disk_bytes{server=\"servu\",instance=\"minecraft\",kind=~\"overworld|the_nether|the_end\"}","legendFormat":"{{kind}}"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0,"custom":{"gradientMode":"none"}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull"]}}},
    {"id":13,"title":"Server, world and backup storage","type":"timeseries","description":"World and BlueMap are included in server; dimensions are included in world. Do not add these overlapping sizes. Backups are local, on the same VM storage.","gridPos":{"x":12,"y":34,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_disk_bytes{server=\"servu\",instance=\"minecraft\",kind=~\"server|world|backups|bluemap\"}","legendFormat":"{{kind}}"},{"refId":"B","expr":"minecraft_filesystem_size_bytes{server=\"servu\",instance=\"minecraft\"} - minecraft_filesystem_free_bytes{server=\"servu\",instance=\"minecraft\"}","legendFormat":"/home used"}],"fieldConfig":{"defaults":{"unit":"bytes","min":0,"custom":{"gradientMode":"none"}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull"]}}},
    {"id":23,"title":"Travel distance · saved totals by movement","type":"bargauge","description":"Game movement counters converted from centimetres to metres. aviate is Elytra flight. Modes are separate; do not assume all movement counters are disjoint.","gridPos":{"x":0,"y":41,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_player_distance_meters_total{server=\"servu\",instance=\"minecraft\",mode=~\"walk|sprint|aviate\"}","legendFormat":"{{player}} · {{mode}}","instant":true}],"fieldConfig":{"defaults":{"unit":"lengthm","min":0},"overrides":[]},"options":{"orientation":"horizontal","displayMode":"basic","reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":28,"title":"Java physical disk I/O","type":"timeseries","description":"Linux process read_bytes/write_bytes counters. Excludes cached reads and includes deferred write accounting; not total logical application I/O.","gridPos":{"x":12,"y":41,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"sum(rate(minecraft_process_disk_read_bytes_total{server=\"servu\",instance=\"minecraft\"}[$__rate_interval]))","legendFormat":"Reads"},{"refId":"B","expr":"sum(rate(minecraft_process_disk_written_bytes_total{server=\"servu\",instance=\"minecraft\"}[$__rate_interval]))","legendFormat":"Writes"}],"fieldConfig":{"defaults":{"unit":"Bps","min":0,"custom":{"gradientMode":"none"}},"overrides":[]},"options":{"tooltip":{"mode":"multi","sort":"none"},"legend":{"displayMode":"table","placement":"right","showLegend":true,"calcs":["lastNotNull"]}}},
    {"id":14,"title":"Diagnostics · backup health","type":"stat","gridPos":{"x":0,"y":48,"w":24,"h":5},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_backup_attempt_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Last attempt succeeded","instant":true},{"refId":"B","expr":"minecraft_backup_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Restic metadata readable","instant":true},{"refId":"C","expr":"1 - minecraft_backup_saving_disabled{server=\"servu\",instance=\"minecraft\"}","legendFormat":"No saving-disabled marker","instant":true}],"fieldConfig":{"defaults":{"min":0,"max":1,"noValue":"Unknown","mappings":[{"type":"value","options":{"0":{"text":"Check","color":"red"},"1":{"text":"OK","color":"green"}}}]},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","textMode":"value_and_name"}},
    {"id":16,"title":"Diagnostics · collector health","type":"stat","gridPos":{"x":0,"y":53,"w":24,"h":5},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"up{job=\"minecraft\",instance=\"minecraft\"}","legendFormat":"Exporter scrape","instant":true},{"refId":"B","expr":"minecraft_log_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Logs readable","instant":true},{"refId":"C","expr":"minecraft_process_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Process readable","instant":true},{"refId":"D","expr":"minecraft_disk_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Storage: {{kind}}","instant":true},{"refId":"E","expr":"minecraft_player_stats_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Saved player stats","instant":true},{"refId":"F","expr":"minecraft_backup_status_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Backup attempt status","instant":true},{"refId":"G","expr":"minecraft_filesystem_collection_success{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Filesystem capacity","instant":true}],"fieldConfig":{"defaults":{"noValue":"Unknown","mappings":[{"type":"value","options":{"0":{"text":"Error","color":"red"},"1":{"text":"OK","color":"green"}}}]},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","textMode":"value_and_name"}},
    {"id":18,"title":"Diagnostics · collector data age","type":"stat","description":"Fast collection every 10s; slow storage/backup collection every 5m. High ages mean a stalled collector, even if HTTP still responds.","gridPos":{"x":0,"y":58,"w":12,"h":5},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"time() - minecraft_fast_collection_timestamp_seconds{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Fast data age","instant":true},{"refId":"B","expr":"time() - minecraft_slow_collection_timestamp_seconds{server=\"servu\",instance=\"minecraft\"}","legendFormat":"Storage/snapshots age","instant":true}],"fieldConfig":{"defaults":{"unit":"s","noValue":"Unknown"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"textMode":"value_and_name"}},
    {"id":25,"title":"Diagnostics · Java OS threads","type":"stat","description":"Operating-system thread count, not active workers or tick threads.","gridPos":{"x":12,"y":58,"w":12,"h":5},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_process_threads{server=\"servu\",instance=\"minecraft\"}","instant":true}],"fieldConfig":{"defaults":{"unit":"short","noValue":"Unknown / stopped"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":17,"title":"Diagnostics · connected time from retained logs","type":"bargauge","description":"Not lifetime playtime: only sessions present in server logs. Deleting logs can reduce this gauge. Includes AFK.","gridPos":{"x":0,"y":63,"w":12,"h":5},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"minecraft_player_retained_log_seconds{server=\"servu\",instance=\"minecraft\"}","legendFormat":"{{player}}","instant":true}],"fieldConfig":{"defaults":{"unit":"s","min":0},"overrides":[]},"options":{"orientation":"horizontal","displayMode":"basic","reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":29,"title":"Diagnostics · saved player stats age","type":"bargauge","description":"Offline players naturally have old saved files; this is not itself an error.","gridPos":{"x":12,"y":63,"w":12,"h":5},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"time() - minecraft_player_stats_saved_timestamp_seconds{server=\"servu\",instance=\"minecraft\"}","legendFormat":"{{player}}","instant":true}],"fieldConfig":{"defaults":{"unit":"s","min":0},"overrides":[]},"options":{"orientation":"horizontal","displayMode":"basic","reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":6,"title":"Diagnostics · newest snapshot age","type":"stat","description":"Creation timestamp of the newest snapshot still in Restic. This can be newer than the last successful pass if retention/pruning failed after a snapshot was created; metadata refreshes every five minutes.","gridPos":{"x":0,"y":68,"w":24,"h":4},"datasource":{"type":"prometheus","uid":"victoriametrics"},"targets":[{"refId":"A","expr":"time() - minecraft_backup_latest_snapshot_timestamp_seconds{server=\"servu\",instance=\"minecraft\"}","instant":true}],"fieldConfig":{"defaults":{"unit":"s","noValue":"Unknown"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]}}}
  ]
}
