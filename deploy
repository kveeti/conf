#!/usr/bin/env bash
set -euo pipefail

flake_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ $# -eq 1 && ( "$1" == "e" || "$1" == "mac" ) ]]; then
  sudo darwin-rebuild switch --flake "path:$flake_dir#e"
  exit
fi

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <host> <target-address> | $0 mac" >&2
  exit 1
fi

host=$1
target=$2

case "$host" in
  atx | backup | public | router | pc) ;;
  *)
    echo "unknown host: $host" >&2
    exit 1
    ;;
esac

remote="veeti@$target"

flake_path=$(nix flake archive --json --to "ssh-ng://$remote" "path:$flake_dir" | jq -er '.path')

ssh -o BatchMode=yes "$remote" \
  sudo -n nixos-rebuild switch \
    --flake "$flake_path#$host" \
    --max-jobs 2 --cores 2
